{
  "name": "project-sun",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A personal daily-mission tracker PWA. Local-first, no accounts, no backend.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test:achievements && npm run test:temporal",
    "test:achievements": "node -e \"require('fs').mkdirSync('node_modules/.cache',{recursive:true})\" && esbuild scripts/achievements-sanity.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/achievements-sanity.test.mjs --log-level=warning && node node_modules/.cache/achievements-sanity.test.mjs",
    "test:temporal": "node -e \"require('fs').mkdirSync('node_modules/.cache',{recursive:true})\" && esbuild scripts/temporal-sanity.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/temporal-sanity.test.mjs --log-level=warning && node node_modules/.cache/temporal-sanity.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1"
  }
}
